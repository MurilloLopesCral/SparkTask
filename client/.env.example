# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# better-auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:5173"

# Email microservice (internal webservice, see /openapi.json)
EMAIL_SERVICE_URL="https://email.internal.example.com"

# SMTP config sent with every request to the email microservice
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER="user@example.com"
EMAIL_SMTP_PASS="change-me"
EMAIL_FROM="SparkTask <no-reply@example.com>"

# System admin — marcar manualmente no banco (em geral 1 usuário):
#   UPDATE "user" SET is_system_admin = true WHERE email = 'voce@empresa.com';
# Depois: /admin → criar grupos e escolher o owner.

# MCP — endpoint público autenticado por access key do usuário (não env):
#   POST /api/mcp  + header x-api-key: spk_…
# Chaves são criadas em Perfil → MCP / agentes (grupo + escopos).
# Claude Desktop: use mcp-remote com --header x-api-key:spk_…

# Vercel Cron — Authorization: Bearer <CRON_SECRET> on /api/cron/*
# Must be set in Vercel Project → Settings → Environment Variables (Production).
# No spaces/newlines when pasting. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me"

# Plexus Service API — sync Spark tasks → gantt items (optional; no-op if unset)
# Auth: Authorization: Bearer plx_<prefix>_<secret>
# Scopes: gantt:write, gantt:read, gantt:delete, users:read
# ownerId do gantt vem de user.plexusUserId (vinculado só pelo system admin)
PLEXUS_API_BASE_URL="https://plexus.example.com"
PLEXUS_SERVICE_KEY="plx_change_me"

# Cloudinary — file attachments on tasks
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"
CLOUDINARY_FOLDER="sparktask"
CLOUDINARY_ALLOWED_FORMATS="jpg,jpeg,png,pdf,csv,xlsx,doc,docx,zip,txt,msg,xls,ogg,opus,mp3,m4a,wav,aac,amr"
CLOUDINARY_MAX_FILE_SIZE_MB="15"

# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# better-auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:5173"

# Email microservice (internal webservice, see /openapi.json)
EMAIL_SERVICE_URL="https://email.internal.example.com"

# SMTP config sent with every request to the email microservice
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER="user@example.com"
EMAIL_SMTP_PASS="change-me"
EMAIL_FROM="SparkTask <no-reply@example.com>"

# Cloudinary — file attachments on tasks
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"
CLOUDINARY_FOLDER="sparktask"
CLOUDINARY_ALLOWED_FORMATS="jpg,jpeg,png,pdf,csv,xlsx,doc,docx,zip,txt,msg,xls,ogg,opus,mp3,m4a,wav,aac,amr"
CLOUDINARY_MAX_FILE_SIZE_MB="15"
